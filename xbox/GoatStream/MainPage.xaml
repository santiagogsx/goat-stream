<Page
    x:Class="GoatStream.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="Black">

    <Grid>
        <!-- the shared Goat Stream UI (web/) -->
        <!-- (its black loading background comes from WEBVIEW2_DEFAULT_BACKGROUND_COLOR in App.xaml.cs) -->
        <controls:WebView2 x:Name="Web" />

        <!-- native 4K / HDR player, shown on top while a movie plays -->
        <Grid x:Name="PlayerLayer" Visibility="Collapsed" Background="Black">
            <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="True" Stretch="Uniform">
                <MediaPlayerElement.TransportControls>
                    <MediaTransportControls x:Name="Controls" IsCompact="False"
                        IsSkipBackwardButtonVisible="True" IsSkipBackwardEnabled="True"
                        IsSkipForwardButtonVisible="True" IsSkipForwardEnabled="True"
                        IsZoomButtonVisible="False" IsFullWindowButtonVisible="False"
                        IsVolumeButtonVisible="False" IsPlaybackRateButtonVisible="False" />
                </MediaPlayerElement.TransportControls>
            </MediaPlayerElement>
            <StackPanel x:Name="TitleBox" VerticalAlignment="Top" Padding="64,40,64,28" Background="#99000000">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Foreground="#FFD978" FontSize="22" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
